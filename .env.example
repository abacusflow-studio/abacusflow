# ==================================================
# PostgreSQL Database
# ==================================================
POSTGRES_VERSION=17-alpine
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres

POSTGRES_MIGRATION_USER=postgres
POSTGRES_MIGRATION_PASSWORD=password

POSTGRES_API_USER=abacusflow_api
POSTGRES_API_PASSWORD=password

POSTGRES_CUBE_USER=abacusflow_cube
POSTGRES_CUBE_PASSWORD=password


# ==================================================
# Cube Analytics Service
# ==================================================
CUBE_VERSION=v1.3

# true: development mode
# false: production mode with stronger API secret validation
CUBEJS_DEV_MODE=false

# Required. Supported values: shared-secret, jwk
CUBEJS_AUTH_MODE=shared-secret

# Optional: Database connection pool size
# Default value is used when omitted
CUBEJS_DB_MAX_POOL=2

# Optional: Query concurrency limit
# Default value is used when omitted
CUBEJS_CONCURRENCY=2

# Optional: Cache and queue driver
# Default: memory
CUBEJS_CACHE_AND_QUEUE_DRIVER=memory

# Optional: Enable scheduled refresh timer
# Default: false
CUBEJS_SCHEDULED_REFRESH_TIMER=false


# Required by Cube. In shared-secret mode it must match
# ABACUSFLOW_CUBE_API_SECRET configured on the backend.
# Generate with: openssl rand -hex 32
ABACUSFLOW_CUBE_API_SECRET=

# JWK mode (for example Auth0): set CUBEJS_AUTH_MODE=jwk and configure all
# three values below. Leave them undefined in shared-secret mode.
# CUBEJS_JWK_URL=https://example.auth0.com/.well-known/jwks.json
# CUBEJS_JWT_ISSUER=https://example.auth0.com/
# CUBEJS_JWT_AUDIENCE=https://api.example.com
# CUBEJS_JWT_ALGS=RS256

# ==================================================
# AbacusFlow APP
# ==================================================
ABACUSFLOW_SERVER_VERSION=latest
ABACUSFLOW_SERVER_HOST=abacusflow-server
ABACUSFLOW_SERVER_PORT=8080
ABACUSFLOW_WEBAPP_VERSION=latest
ABACUSFLOW_WEBAPP_HTTP_PORT=5173
ABACUSFLOW_WEBAPP_HTTPS_PORT=5174


# ==================================================
# S3 Compatible Storage
# ==================================================

S3_ENDPOINT=https://<your-endpoint-ref>/storage/v1/s3
S3_BUCKET=feedback
S3_ACCESS_KEY=<your-s3-access-key>
S3_SECRET_KEY=<your-s3-secret-key>
S3_REGION=us-east-1
