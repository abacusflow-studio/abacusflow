{
  "name": "abacusflow-mobile",
  "version": "0.0.0-private",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint src scripts --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "eas:dev:android": "npx eas build --platform android --profile development",
    "eas:dev:ios": "npx eas build --platform ios --profile development",
    "eas:preview:android": "npx eas build --platform android --profile preview",
    "eas:preview:ios": "npx eas build --platform ios --profile preview",
    "eas:production:android": "npx eas build --platform android --profile production",
    "eas:production:ios": "npx eas build --platform ios --profile production",
    "eas:submit": "npx eas submit --profile production"
  },
  "dependencies": {
    "@abacusflow/config": "*",
    "@abacusflow/core": "*",
    "@abacusflow/utils": "*",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@rn-primitives/portal": "^1.4.0",
    "@rn-primitives/slot": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "^56.0.8",
    "expo-audio": "~56.0.11",
    "expo-auth-session": "^56.0.13",
    "expo-camera": "~56.0.7",
    "expo-constants": "^56.0.16",
    "expo-dev-client": "^56.0.18",
    "expo-font": "~56.0.5",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.9",
    "expo-image-picker": "~56.0.15",
    "expo-linking": "^56.0.13",
    "expo-router": "^56.2.8",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "^56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.5",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.5",
    "moti": "^0.30.0",
    "nativewind": "^4.2.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "^4.25.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/react": "~19.2.14",
    "babel-preset-expo": "^56.0.14",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~56.0.4",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  }
}
